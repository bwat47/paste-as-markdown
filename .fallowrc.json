{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": [
        "src/index.ts",
        "src/editor/contentScripts/codeMirror5.ts",
        "src/editor/contentScripts/codeMirror6.ts",
        "src/dialog/webview/pasteOptionsDialog.css",
        "scripts/updateHighlightLanguages.js"
    ],
    "supportEntry": ["src/**/*.test.ts", "src/__tests__/setup.ts", "src/__tests__/__mocks__/**"],
    "ignorePatterns": ["**/*.d.ts", "api/**"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off"
    },
    "health": {
        "maxCognitive": 15,
        "maxCyclomatic": 20,
        "ignore": ["scripts/**"]
    }
}
