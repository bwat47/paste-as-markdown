{
    "name": "joplin-plugin-paste-as-markdown",
    "version": "1.6.0",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "eslint src/ test/",
        "lint:fix": "eslint src/ test/ --fix",
        "format": "prettier --write \"src/**/*.{ts,js,css}\"",
        "test": "vitest run && node --test test/*.test.mjs",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "knip": "knip",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.5.0",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.9.4",
        "@types/turndown": "^5.0.6",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.0",
        "eslint-plugin-sonarjs": "^4.2.2",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^14.0.0",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@bwat47/turndown-plugin-gfm": "1.1.2",
        "@lezer/markdown": "^1.7.2",
        "dompurify": "^3.4.17",
        "file-type": "^22.3.0",
        "turndown": "7.2.5"
    }
}
