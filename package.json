{
    "name": "joplin-plugin-paste-as-markdown",
    "version": "1.6.1",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "oxlint src/",
        "lint:fix": "oxlint src/ --fix",
        "format": "prettier --write \"src/**/*.{ts,js,css}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "knip": "knip",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.5.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^25.9.4",
        "@types/turndown": "^5.0.6",
        "@vitest/coverage-v8": "^5.0.5",
        "jsdom": "^31.0.0",
        "knip": "^6.44.1",
        "oxlint": "^1.93.0",
        "oxlint-plugin-complexity": "^4.1.0",
        "oxlint-tsgolint": "^7.0.2007",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@bwat47/turndown-plugin-gfm": "1.1.2",
        "@lezer/markdown": "^1.7.2",
        "dompurify": "^3.4.17",
        "file-type": "^22.3.0",
        "turndown": "7.2.5"
    }
}
