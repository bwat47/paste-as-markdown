{
    "name": "joplin-plugin-paste-as-markdown",
    "version": "1.6.1",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.6.0",
        "@types/node": "^24.19.2",
        "@types/turndown": "^5.0.6",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.43.0",
        "jsdom": "^31.0.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@bwat47/turndown-plugin-gfm": "1.1.2",
        "@lezer/markdown": "^1.7.2",
        "dompurify": "^3.4.17",
        "file-type": "^22.3.0",
        "turndown": "7.2.5"
    }
}
