{
    "manifest_version": 1,
    "id": "com.bwat47.paste-as-markdown",
    "app_min_version": "3.3",
    "version": "1.4.3",
    "name": "Paste HTML as Markdown",
    "description": "Paste clipboard HTML as clean markdown",
    "author": "bwat47",
    "homepage_url": "https://github.com/bwat47/paste-as-markdown",
    "repository_url": "https://github.com/bwat47/paste-as-markdown",
    "keywords": ["copy", "paste", "html", "text", "images", "markdown"],
    "categories": ["productivity", "editor"],
    "screenshots": [
        { "src": "images/paste-as-markdown1.png", "label": "paste as markdown example 1" },
        { "src": "images/paste-as-markdown2.png", "label": "paste as markdown example 2" },
        { "src": "images/paste-as-markdown3.png", "label": "paste as markdown example 3" }
    ],
    "icons": {
        "128": "images/128.png",
        "64": "images/64.png",
        "48": "images/48.png",
        "32": "images/32.png",
        "16": "images/16.png"
